---
import { MAIN_NAV, SITE } from '../config/site';

interface Props {
  section?: 'home' | 'articles' | 'projects' | 'about';
}

const { section } = Astro.props;
const isCurrent = (itemSection: string) => itemSection === section;
const navItems = MAIN_NAV.filter((item) => item.section !== 'home');
---

<header class="util">
  <a class="util-brand" href="/" aria-label={`${SITE.nameEn} ${SITE.name} 首页`}>
    Jary<b>8</b><span>{SITE.name}</span>
  </a>

  <nav class="util-nav" aria-label="主导航">
    {
      navItems.map((item, index) => (
        <a href={item.href} aria-current={isCurrent(item.section) ? 'page' : undefined}>
          <i aria-hidden="true">0{index + 1}</i>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="util-tools">
    <span class="util-clock" data-clock aria-hidden="true">UTC+8 --:--</span>
    <button
      class="index-trigger"
      type="button"
      data-open-search
      aria-label="打开索引搜索"
      aria-haspopup="dialog"
      aria-controls="searchDialog"
    >
      <span>索引</span>
      <kbd aria-hidden="true">⌘K</kbd>
    </button>
    <button class="theme-btn" type="button" data-theme-toggle aria-label="切换明暗主题" title="切换明暗主题">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5Z"></path></svg>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');

  function currentTheme(): 'light' | 'dark' {
    return root.dataset.theme === 'light' ? 'light' : 'dark';
  }

  function applyTheme(theme: 'light' | 'dark', persist: boolean) {
    root.dataset.theme = theme;
    if (themeMeta) themeMeta.content = theme === 'dark' ? '#14171f' : '#f5f5f2';
    if (themeToggle) {
      const label = theme === 'dark' ? '切换到浅色模式' : '切换到深色模式';
      themeToggle.setAttribute('aria-label', label);
      themeToggle.setAttribute('title', label);
    }
    if (persist) {
      try {
        localStorage.setItem('jary-theme', theme);
      } catch {
        /* 隐私模式下不持久化，本次会话仍然生效 */
      }
    }
    root.dispatchEvent(new CustomEvent('jary-theme-change', { detail: theme }));
  }

  applyTheme(currentTheme(), false);

  themeToggle?.addEventListener('click', () => {
    applyTheme(currentTheme() === 'dark' ? 'light' : 'dark', true);
  });

  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('zh-CN', {
      timeZone: 'Asia/Shanghai',
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    });
    const tick = () => {
      clock.textContent = `UTC+8 ${fmt.format(new Date())}`;
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>
