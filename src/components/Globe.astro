---
---
<div class="hero-ornament" aria-hidden="true">
  <div class="orb-wrap" data-orb>
    <svg class="orb-static" viewBox="0 0 400 400" focusable="false">
      <defs>
        <pattern id="orbDotA" width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.15" class="orb-dot"></circle></pattern>
        <clipPath id="orbClipA"><circle cx="202" cy="198" r="118"></circle></clipPath>
        <radialGradient id="orbShadeA" cx="36%" cy="30%" r="76%"><stop offset="0" stop-color="#fff" stop-opacity=".95"></stop><stop offset=".62" stop-color="#fff" stop-opacity=".55"></stop><stop offset="1" stop-color="#fff" stop-opacity=".08"></stop></radialGradient>
        <mask id="orbMaskA"><rect width="400" height="400" fill="url(#orbShadeA)"></rect></mask>
      </defs>
      <ellipse cx="200" cy="204" rx="178" ry="46" class="orb-line" transform="rotate(-18 200 204)"></ellipse>
      <g clip-path="url(#orbClipA)" mask="url(#orbMaskA)"><rect x="84" y="80" width="236" height="236" fill="url(#orbDotA)"></rect></g>
      <circle cx="202" cy="198" r="118" class="orb-line" fill="none"></circle>
      <circle cx="312" cy="128" r="4" class="orb-dot-fill"></circle>
    </svg>
    <canvas class="orb-canvas" data-orb-canvas></canvas>
  </div>
</div>

<script>
  // 首页 Hero 地球点缀：handoff §7 参数 + J-03 生命周期；降级留 poster（§8）
  const wrap = document.querySelector<HTMLElement>('[data-orb]');
  const canvas = wrap?.querySelector<HTMLCanvasElement>('[data-orb-canvas]');
  if (wrap && canvas) {
    const motionOff = new URLSearchParams(location.search).get('motion') === 'off';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const networkLite = () => {
      const c = (
        navigator as Navigator & {
          connection?: { saveData?: boolean; effectiveType?: string };
        }
      ).connection;
      return !!(c && (c.saveData || /(^|-)2g$/.test(c.effectiveType || '')));
    };
    const N = 900;
    const pts: Array<{ x: number; y: number; z: number }> = [];
    for (let i = 0; i < N; i += 1) {
      const y = 1 - (i / (N - 1)) * 2;
      const r = Math.sqrt(Math.max(0, 1 - y * y));
      const theta = i * Math.PI * (3 - Math.sqrt(5));
      pts.push({ x: Math.cos(theta) * r, y, z: Math.sin(theta) * r });
    }
    const ctx = canvas.getContext('2d');
    let rot = 2.24;
    let raf = 0;
    let running = false;
    let inView = true;
    let pageVisible = !document.hidden;
    const look = { x: 0, y: 0 };
    const pointer = { x: 0.5, y: 0.5, inside: false };

    const token = (name: string, fallback: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

    function draw() {
      if (!ctx) return;
      const w = wrap!.clientWidth;
      const h = wrap!.clientHeight;
      if (!w || !h) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      if (canvas!.width !== Math.round(w * dpr) || canvas!.height !== Math.round(h * dpr)) {
        canvas!.width = Math.round(w * dpr);
        canvas!.height = Math.round(h * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (networkLite()) {
        setLive(false);
        return;
      }
      setLive(window.innerWidth > 620);
      if (window.innerWidth <= 620) return;

      const blue = token('--blue', '#1b2cff');
      const line = token('--line-2', 'rgba(22,22,19,.42)');
      const faint = token('--faint', line);
      ctx.clearRect(0, 0, w, h);
      const cx = w * 0.52;
      const cy = h * 0.5;
      const R = Math.min(w, h) * 0.3;

      ctx.strokeStyle = line;
      ctx.globalAlpha = 0.12;
      ctx.lineWidth = 1;
      const grid = Math.max(28, w / 16);
      for (let x = (w / 2) % grid; x < w; x += grid) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, h);
        ctx.stroke();
      }
      for (let y = (h / 2) % grid; y < h; y += grid) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(w, y);
        ctx.stroke();
      }

      ctx.save();
      ctx.translate(cx, cy);
      ctx.rotate(-0.34);
      ctx.beginPath();
      ctx.ellipse(0, 0, R * 1.28, R * 0.46, 0, 0, Math.PI * 2);
      ctx.strokeStyle = blue;
      ctx.globalAlpha = 0.72;
      ctx.stroke();
      ctx.restore();

      const live = running && !motionOff && !reduced.matches;
      const yaw = rot + (live ? look.x * 0.36 : 0);
      const pitch = live ? look.y * 0.22 : 0;
      const cos = Math.cos(yaw);
      const sin = Math.sin(yaw);
      const cosX = Math.cos(pitch);
      const sinX = Math.sin(pitch);
      const projected = pts.map((p) => {
        const x = p.x * cos + p.z * sin;
        const z = -p.x * sin + p.z * cos;
        const y = p.y * cosX - z * sinX;
        const z2 = p.y * sinX + z * cosX;
        const depth = (z2 + 1) / 2;
        const scale = 0.92 + depth * 0.08;
        return { sx: cx + x * R * scale, sy: cy + y * R * scale, depth, z: z2 };
      });
      projected.sort((a, b) => a.z - b.z);
      ctx.fillStyle = blue;
      for (const p of projected) {
        ctx.globalAlpha = 0.08 + p.depth * 0.56;
        ctx.beginPath();
        ctx.arc(p.sx, p.sy, 0.55 + p.depth * 0.9, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalAlpha = 0.14;
      ctx.strokeStyle = line;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 0.92, 0, Math.PI * 2);
      ctx.stroke();

      if (pointer.inside) {
        const px = pointer.x * w;
        const py = pointer.y * h;
        ctx.globalAlpha = 0.48;
        ctx.strokeStyle = blue;
        ctx.beginPath();
        ctx.moveTo(px, 0);
        ctx.lineTo(px, h);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(0, py);
        ctx.lineTo(w, py);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(px, py, 4, 0, Math.PI * 2);
        ctx.stroke();
        ctx.globalAlpha = 0.9;
        ctx.fillStyle = blue;
        ctx.font = '8px "JetBrains Mono", monospace';
        ctx.fillText(
          `${pointer.x.toFixed(3)} / ${pointer.y.toFixed(3)}`,
          Math.min(px + 8, w - 78),
          Math.max(py - 8, 10),
        );
        ctx.globalAlpha = 0.4;
        ctx.fillRect(0, py, 14, 1);
        ctx.fillRect(w - 14, py, 14, 1);
      }

      ctx.globalAlpha = 0.42;
      ctx.fillStyle = faint;
      ctx.font = '8px "JetBrains Mono", monospace';
      ctx.fillText('CORE / 900 PTS', 14, h - 38);
      ctx.fillText('ORBIT / 1', 14, h - 24);
      ctx.globalAlpha = 1;
    }

    function setLive(on: boolean) {
      canvas!.classList.toggle('is-live', on);
      wrap!.classList.toggle('is-live', on);
    }

    function eligible() {
      return (
        !motionOff &&
        !reduced.matches &&
        inView &&
        pageVisible &&
        !networkLite() &&
        window.innerWidth > 620
      );
    }

    function loop() {
      if (!running) return;
      if (!eligible()) {
        stop();
        draw();
        return;
      }
      rot += 0.0022;
      const tx = pointer.inside ? pointer.x - 0.5 : 0;
      const ty = pointer.inside ? pointer.y - 0.5 : 0;
      look.x += (tx - look.x) * 0.1;
      look.y += (ty - look.y) * 0.1;
      draw();
      raf = requestAnimationFrame(loop);
    }

    function start() {
      if (running || !eligible()) {
        draw();
        return;
      }
      running = true;
      loop();
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    wrap.addEventListener('pointermove', (event) => {
      const rect = wrap.getBoundingClientRect();
      pointer.x = (event.clientX - rect.left) / rect.width;
      pointer.y = (event.clientY - rect.top) / rect.height;
      pointer.inside = true;
      if (motionOff || reduced.matches) draw();
    });
    wrap.addEventListener('pointerleave', () => {
      pointer.inside = false;
      if (motionOff || reduced.matches) draw();
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          if (!inView) stop();
          else start();
        },
        { threshold: 0.05 },
      ).observe(wrap);
    }
    document.addEventListener('visibilitychange', () => {
      pageVisible = !document.hidden;
      if (!pageVisible) stop();
      else start();
    });
    reduced.addEventListener('change', () => {
      stop();
      start();
      draw();
    });
    if ('ResizeObserver' in window) {
      new ResizeObserver(() => {
        if (window.innerWidth <= 620) stop();
        else start();
        draw();
      }).observe(wrap);
    }
    document.documentElement.addEventListener('jary-theme-change', () => {
      if (!running) draw();
    });

    draw();
    start();
  }
</script>
