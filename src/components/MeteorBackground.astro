---
/* 暗夜星轨：斜向流星带。仅首页 Hero 与 404 使用（方案 §2.4 硬预算）。
   生命周期范式复用 Globe.astro：poster 先行、IO/visibility 暂停、reduced-motion/saveData 降级、DPR≤1.5。 */
---

<div class="meteor-field" data-meteor aria-hidden="true">
  <div class="meteor-poster"></div>
  <canvas class="meteor-canvas" data-meteor-canvas></canvas>
</div>

<script>
  // 硬预算：线 ≤60、点 ≤100、DPR ≤1.5；窄屏仅点无线；禁止 shadowBlur/逐粒子渐变
  const MAX_LINES = 60;
  const MAX_DOTS = 100;
  const MOBILE_DOTS = 40;

  document.querySelectorAll<HTMLElement>('[data-meteor]').forEach((field) => {
    const canvas = field.querySelector<HTMLCanvasElement>('[data-meteor-canvas]');
    if (!canvas || canvas.dataset.meteorBound) return;
    canvas.dataset.meteorBound = '1';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const motionOff = new URLSearchParams(location.search).get('motion') === 'off';
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const networkLite = () => {
      const conn = (
        navigator as Navigator & {
          connection?: { saveData?: boolean; effectiveType?: string };
        }
      ).connection;
      return !!(conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || '')));
    };

    // 斜向 ~65°（自右上到左下）
    const ANG = (65 * Math.PI) / 180;
    const DX = -Math.cos(ANG);
    const DY = -Math.sin(ANG);
    const ALPHAS = [0.06, 0.12, 0.18];

    type Line = { x: number; y: number; len: number; a: number; v: number };
    type Dot = { x: number; y: number; r: number; c: 0 | 1 | 2; v: number; tw: number };
    let lines: Line[] = [];
    let dots: Dot[] = [];
    let W = 0;
    let H = 0;
    let raf = 0;
    let running = false;
    let inView = true;
    let pageVisible = !document.hidden;

    const token = (name: string, fallback: string) =>
      getComputedStyle(document.documentElement).getPropertyValue(name).trim() || fallback;

    let ink = '#e9ecf2';
    let accent = '#ff3d81';
    let cool = '#56d1e0';

    function seed() {
      const mobile = W > 0 && W <= 620;
      const nLines = mobile ? 0 : MAX_LINES;
      const nDots = mobile ? MOBILE_DOTS : MAX_DOTS;
      const span = Math.hypot(W, H);
      lines = Array.from({ length: nLines }, () => ({
        x: Math.random() * (W + span) - span * 0.5,
        y: Math.random() * (H + span) - span * 0.5,
        len: 60 + Math.random() * 160,
        a: ALPHAS[Math.floor(Math.random() * ALPHAS.length)] ?? 0.06,
        v: 0.12 + Math.random() * 0.22,
      }));
      dots = Array.from({ length: nDots }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: Math.random() < 0.7 ? 1 : 1.6,
        // 品红:青蓝 ≈ 1:2 → 约 1/3 accent、2/3 cool
        c: (Math.random() < 0.33 ? 1 : 2) as 0 | 1 | 2,
        v: 0.05 + Math.random() * 0.1,
        tw: Math.random() * Math.PI * 2,
      }));
    }

    function fit() {
      const w = field.clientWidth;
      const h = field.clientHeight;
      if (!w || !h) return false;
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      if (canvas!.width !== Math.round(w * dpr) || canvas!.height !== Math.round(h * dpr)) {
        canvas!.width = Math.round(w * dpr);
        canvas!.height = Math.round(h * dpr);
      }
      const resized = w !== W || h !== H;
      W = w;
      H = h;
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (resized) seed();
      return true;
    }

    function paint(animated: boolean) {
      if (!ctx || !W || !H) return;
      ink = token('--ink', ink);
      accent = token('--accent', accent);
      cool = token('--cool', cool);
      ctx.clearRect(0, 0, W, H);
      ctx.lineWidth = 1;
      ctx.strokeStyle = ink;
      for (const l of lines) {
        ctx.globalAlpha = l.a;
        ctx.beginPath();
        ctx.moveTo(l.x, l.y);
        ctx.lineTo(l.x - DX * l.len, l.y - DY * l.len);
        ctx.stroke();
        if (animated) {
          l.x += DX * l.v;
          l.y += DY * l.v;
          if (l.y > H + 40 || l.x < -240) {
            l.x = W + Math.random() * 240;
            l.y = -40 + Math.random() * H * 0.4;
          }
        }
      }
      for (const d of dots) {
        ctx.globalAlpha = animated ? 0.5 + 0.4 * Math.sin(d.tw) : 0.6;
        ctx.fillStyle = d.c === 1 ? accent : cool;
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
        ctx.fill();
        if (animated) {
          d.tw += 0.02;
          d.x += DX * d.v;
          d.y += DY * d.v;
          if (d.y > H + 4 || d.x < -4) {
            d.x = W + Math.random() * 8;
            d.y = Math.random() * H;
          }
        }
      }
      ctx.globalAlpha = 1;
    }

    function setLive(on: boolean) {
      canvas!.classList.toggle('is-live', on);
      field.classList.toggle('is-live', on);
    }

    function eligible() {
      return (
        !motionOff &&
        !reduced.matches &&
        inView &&
        pageVisible &&
        !networkLite() &&
        window.innerWidth > 480
      );
    }

    function loop() {
      if (!running) return;
      if (!eligible()) {
        stop();
        paint(false);
        setLive(false);
        return;
      }
      paint(true);
      raf = requestAnimationFrame(loop);
    }

    function start() {
      if (running) return;
      if (!fit() || !eligible()) {
        setLive(false);
        if (fit()) paint(false);
        return;
      }
      running = true;
      setLive(true);
      loop();
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        ([entry]) => {
          inView = entry.isIntersecting;
          if (!inView) stop();
          else start();
        },
        { threshold: 0.05 },
      ).observe(field);
    }
    document.addEventListener('visibilitychange', () => {
      pageVisible = !document.hidden;
      if (!pageVisible) stop();
      else start();
    });
    reduced.addEventListener('change', () => {
      stop();
      start();
    });
    if ('ResizeObserver' in window) {
      new ResizeObserver(() => {
        fit();
        if (!running) paint(false);
      }).observe(field);
    }
    document.documentElement.addEventListener('jary-theme-change', () => {
      if (!running) paint(false);
    });

    if (fit()) {
      paint(false);
      start();
    }
  });
</script>

<style>
  .meteor-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .meteor-poster {
    position: absolute;
    inset: 0;
    opacity: 0.55;
    transition: opacity 600ms var(--ease);
    background:
      radial-gradient(1.6px 1.6px at 14% 22%, var(--cool) 48%, transparent 52%),
      radial-gradient(1.6px 1.6px at 82% 16%, var(--cool) 48%, transparent 52%),
      radial-gradient(1.6px 1.6px at 68% 72%, var(--accent) 48%, transparent 52%),
      radial-gradient(1.4px 1.4px at 34% 82%, var(--cool) 48%, transparent 52%),
      radial-gradient(1.4px 1.4px at 90% 54%, var(--cool) 48%, transparent 52%),
      radial-gradient(1.4px 1.4px at 8% 62%, var(--accent) 48%, transparent 52%),
      radial-gradient(1.2px 1.2px at 48% 12%, var(--cool) 48%, transparent 52%),
      radial-gradient(1.2px 1.2px at 58% 42%, var(--accent) 48%, transparent 52%),
      repeating-linear-gradient(
        155deg,
        transparent 0 84px,
        color-mix(in srgb, var(--ink) 7%, transparent) 84px 85px,
        transparent 85px 158px,
        color-mix(in srgb, var(--ink) 12%, transparent) 158px 159px,
        transparent 159px 233px,
        color-mix(in srgb, var(--ink) 18%, transparent) 233px 234px
      );
  }

  .meteor-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms var(--ease);
  }

  .meteor-canvas.is-live {
    opacity: 1;
  }

  .meteor-field.is-live .meteor-poster {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .meteor-poster {
      transition: none;
    }
  }
</style>
