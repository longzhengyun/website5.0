---
import { MAIN_NAV, SITE } from '../config/site';
import { getLinkGroups, getVersionLogs } from '../lib/data';
import type { ProfileEntry } from '../lib/content';

interface Props {
  profile: ProfileEntry;
}

const { profile } = Astro.props;
const meta = profile.data.siteMeta;
const hasLinks = getLinkGroups().length > 0;
const currentYear = new Date().getFullYear();
const yearRange =
  meta.startedYear === currentYear ? `${currentYear}` : `${meta.startedYear}–${currentYear}`;
const domain = meta.siteDomain;
const domainHref = domain
  ? domain.startsWith('http')
    ? domain
    : `https://${domain}`
  : undefined;
const latestVersion = getVersionLogs()[0];
const issueNo = latestVersion
  ? String(parseInt(latestVersion.version.replace(/^V/i, ''), 10)).padStart(2, '0')
  : null;
const timezone = profile.data.timezone ?? 'UTC+8';
---

<footer class="site-foot">
  <div class="foot-top">
    <div class="foot-mark" aria-hidden="true">JARY<b>8</b></div>
    <div class="foot-cols">
      <div class="foot-col">
        <h3>Index</h3>
        {
          MAIN_NAV.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))
        }
        {hasLinks && <a href="/#links">常去</a>}
        <a href="/sitemap.xml">站点地图</a>
      </div>
      <div class="foot-col">
        <h3>Issue</h3>
        {
          latestVersion && issueNo && (
            <p>
              No. {issueNo} / {latestVersion.date}
            </p>
          )
        }
        <p>静态构建 · 无数据库 · 0 第三方</p>
      </div>
      <div class="foot-col">
        <h3>Contact</h3>
        {
          profile.data.showEmail && (
            <a href={`mailto:${profile.data.email}`}>{profile.data.email}</a>
          )
        }
        <a href={profile.data.github} target="_blank" rel="noopener noreferrer">
          GitHub<span class="sr-only">（新窗口）</span>
        </a>
        <a href="/rss.xml">RSS 订阅</a>
        {
          domainHref && domain && (
            <a href={domainHref} target="_blank" rel="noopener noreferrer">
              {domain}<span class="sr-only">（新窗口）</span>
            </a>
          )
        }
      </div>
    </div>
  </div>

  <div class="foot-bottom">
    <p>
      © {yearRange} {meta.copyrightName} · SITE SINCE {meta.startedYear}
      {
        meta.icp && (
          <>
            {' · '}
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
              {meta.icp}
              <span class="sr-only">（新窗口）</span>
            </a>
          </>
        )
      }
    </p>
    <p>
      Set in <b>Inter</b> · <b>Instrument Serif</b> &amp; <b>JetBrains Mono</b> · {timezone} · {SITE.nameEn}
    </p>
  </div>
</footer>
