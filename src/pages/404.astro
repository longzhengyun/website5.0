---
import BaseLayout from '../layouts/BaseLayout.astro';
import MeteorBackground from '../components/MeteorBackground.astro';
import { articlePath, getPublishedArticles } from '../lib/content';

const description = '请求的页面不存在或已经移动。可以返回封面，或从索引里重新找一条路径。';
const articles = (await getPublishedArticles()).slice(0, 3);
---

<BaseLayout title="页面不存在" description={description} noindex noCanonical>
  <div class="page">
    <div class="e404">
      <MeteorBackground />
      <p class="e404-kicker">Error / Not in this issue</p>
      <h1 aria-label="404 页面未找到">
        <span aria-hidden="true">4</span><span aria-hidden="true">0</span><span aria-hidden="true">4</span>
      </h1>
      <p class="e404-copy">
        这个页码不存在。链接可能已经过期，或者它从未被收录进这一期。回到封面，或者从索引里重新找一条路径。
      </p>
      <div class="e404-actions">
        <a class="btn btn-primary" href="/">
          返回封面 <span aria-hidden="true">↗</span>
        </a>
        <button
          class="btn"
          type="button"
          data-open-search
          aria-haspopup="dialog"
          aria-controls="searchDialog"
        >
          打开索引
        </button>
      </div>
      {articles.length > 0 && (
        <div class="e404-index">
          <h2>或许你在找 / Try these</h2>
          {articles.map((article, index) => (
            <a href={articlePath(article.data.slug)}>
              <span>{String(index + 1).padStart(3, '0')}</span>
              {article.data.title}
              <em aria-hidden="true">↗</em>
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</BaseLayout>
