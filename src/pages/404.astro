---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = '请求的页面不存在或已经移动。可以返回首页，或搜索文章与项目。';
---

<BaseLayout title="页面不存在" description={description} noindex noCanonical>
  <div class="page">
    <div class="page-shell">
      <div class="not-found">
        <p class="not-found-code">ERROR / 404</p>
        <h1 class="not-found-title">这一页不在了。</h1>
        <p>链接可能已经失效，页面也可能被重命名。可以返回首页重新出发，或直接搜索文章与项目。</p>
        <div class="not-found-actions">
          <a class="btn btn-primary" href="/">
            返回首页
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn-ghost" href="/articles/">阅读文章</a>
          <button
            class="btn btn-ghost"
            type="button"
            data-open-search
            aria-haspopup="dialog"
            aria-controls="searchDialog"
          >
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16.5 16.5 4 4"></path></svg>
            搜索
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
