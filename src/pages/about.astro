---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProfile } from '../lib/content';
import { getVersionLogs } from '../lib/data';

const profile = await getProfile();
const { Content } = await render(profile);
const { data } = profile;
const meta = data.siteMeta;
const versionLogs = getVersionLogs();
const timezone = data.timezone ?? 'UTC+8';
const jobTitle = 'Web 前端开发';
const skills = data.skills.filter((group) => group.items.length > 0);
const description =
  '关于佳瑞网作者 Jary：多年 Web 前端开发经验，关注界面、性能与可维护性；这里记录技能、站点版本与联系方式。';
const site = Astro.site ?? new URL('https://jary8.com');
const aboutUrl = new URL('/about/', site).href;
const [emailUser, emailDomain] = data.email.split('@');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: data.name,
  alternateName: data.englishName,
  url: aboutUrl,
  description: data.shortBio,
  jobTitle,
  knowsAbout: skills.flatMap((group) => group.items.map((item) => item.name)),
  sameAs: [data.github, ...data.socials.map((social) => social.url)],
};
---

<BaseLayout section="about" title="关于" description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <div class="page" data-pagefind-body data-pagefind-meta="type:页面">
    <header class="page-head">
      <div>
        <p class="page-kicker">Profile / Colophon</p>
        <h1 id="page-title" tabindex="-1" data-pagefind-meta="title">
          关于<em>{data.englishName}</em>
        </h1>
        <p class="page-dek">{data.shortBio}</p>
      </div>
      <p class="page-side">
        {jobTitle}<br />
        {timezone}<br />
        {meta.careerStartYear ? <>Since {meta.careerStartYear}</> : <>EST. {meta.startedYear}</>}
      </p>
    </header>

    <div class="about-hero">
      <div>
        <p class="page-kicker">The Author / 作者</p>
        <h2 class="about-name">{data.name}<i>.</i></h2>
      </div>
      <div class="about-intro" data-prose-content>
        <Content />
      </div>
    </div>

    <div class="about-grid">
      {skills.length > 0 && (
        <section class="about-section" aria-labelledby="skills-title">
          <h2 id="skills-title">技能<em>Skills</em></h2>
          {skills.map((group) => (
            <div class="skill-group">
              <h3>{group.group}</h3>
              {group.items.map((item) => (
                <div class="skill-row"><span>{item.name}</span><span>{item.level}</span></div>
              ))}
            </div>
          ))}
        </section>
      )}

      {versionLogs.length > 0 && (
        <section class="about-section" aria-labelledby="editions-title" id="version">
          <h2 id="editions-title">版本<em>Editions</em></h2>
          <table class="editions">
            <caption class="sr-only">站点版本记录</caption>
            <thead>
              <tr><th scope="col">Edition</th><th scope="col">说明</th><th scope="col">时间</th></tr>
            </thead>
            <tbody>
              {versionLogs.map((log) => (
                <tr>
                  <td>{log.version}</td>
                  <td>
                    {log.title}
                    {log.summary && <span class="edition-tech">{log.summary}</span>}
                    {log.tech.length > 0 && (
                      <span class="edition-tech">{log.tech.join(' / ')}</span>
                    )}
                  </td>
                  <td>{log.date}</td>
                </tr>
              ))}
              <tr>
                <td>始</td>
                <td>站点建立，开始持续写作</td>
                <td>{meta.startedYear}</td>
              </tr>
            </tbody>
          </table>
        </section>
      )}
    </div>

    <div class="colophon">
      <div>
        <h3>Type</h3>
        Instrument Serif<br />JetBrains Mono<br />系统中文无衬线
      </div>
      <div>
        <h3>Build</h3>
        Astro + MDX<br />静态输出<br />无数据库 · 0 第三方
      </div>
      <div>
        <h3>Search</h3>
        Pagefind<br />按需加载<br />不进入首屏
      </div>
      <div>
        <h3>Reading</h3>
        深 / 浅色<br />跟随系统<br />可键盘操作
      </div>
    </div>

    <section class="section" aria-labelledby="contact-title">
      <div class="section-head">
        <div>
          <p class="sec-kicker">Contact / 联系</p>
          <h2 class="sec-title" id="contact-title">保持联系<em>Elsewhere</em></h2>
        </div>
      </div>
      <p class="page-dek">
        {data.showEmail
          ? '没有表单；可以通过邮箱、GitHub 或 RSS 保持联系。'
          : '没有表单；邮箱按需显示，也可以直接通过 GitHub 或 RSS 保持联系。'}
      </p>
      <div class="contact-chips">
        {data.showEmail ? (
          <a href={`mailto:${data.email}`}>Email</a>
        ) : (
          data.email && (
            <button
              type="button"
              data-email-reveal
              data-email-user={emailUser}
              data-email-domain={emailDomain}
            >
              点击显示邮箱
            </button>
          )
        )}
        <a href={data.github} target="_blank" rel="noopener noreferrer">
          GitHub<span aria-hidden="true"> ↗</span><span class="sr-only">（新窗口）</span>
        </a>
        <a href="/rss.xml">RSS</a>
        <a href="/sitemap.xml">Sitemap</a>
        {meta.siteDomain && (
          <a
            href={meta.siteDomain.startsWith('http') ? meta.siteDomain : `https://${meta.siteDomain}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {meta.siteDomain}<span aria-hidden="true"> ↗</span><span class="sr-only">（新窗口）</span>
          </a>
        )}
      </div>
    </section>
  </div>

  <script is:inline>
    (function () {
      var button = document.querySelector('[data-email-reveal]');
      if (!button) return;
      button.addEventListener('click', function () {
        var email = button.getAttribute('data-email-user') + '@' + button.getAttribute('data-email-domain');
        var link = document.createElement('a');
        link.href = 'mailto:' + email;
        link.textContent = email;
        link.setAttribute('data-email-shown', '');
        button.parentNode.replaceChild(link, button);
        link.focus();
      });
    })();
  </script>
</BaseLayout>
