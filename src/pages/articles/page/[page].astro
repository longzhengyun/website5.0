---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleListPage from '../../../components/ArticleListPage.astro';
import { ARTICLES_PER_PAGE } from '../../../config/site';
import { getPublishedArticles, paginate } from '../../../lib/content';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  const totalPages = Math.max(1, Math.ceil(articles.length / ARTICLES_PER_PAGE));
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const articles = await getPublishedArticles();
const pageNumber = Number(Astro.params.page);
const { items, currentPage, totalPages } = paginate(articles, pageNumber);
---

<BaseLayout
  section="articles"
  title={`文章 · 第 ${currentPage} 页`}
  description={`佳瑞网的文章列表第 ${currentPage} 页，继续浏览 Web 前端、界面设计、性能优化与工程化的实践和取舍。`}
>
  <ArticleListPage
    allArticles={articles}
    pageArticles={items}
    page={currentPage}
    totalPages={totalPages}
  />
</BaseLayout>
